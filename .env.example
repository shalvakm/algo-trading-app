# --- Kite Connect credentials (from https://developers.kite.trade) ---
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret

# --- Strategy ---
# Comma-separated NSE trading symbols
# How to choose the stocks to trade:
#   fixed = trade the SYMBOLS list below
#   scan  = each day at startup, pick the SCAN_TOP F&O stocks with the most UNUSUAL activity in the last
#           session (turnover vs their own 20-day average). Backtest (60-min, Jul-Oct 2026, 211 F&O stocks):
#           about +0.30% per trade vs ~0% for a fixed list. SYMBOLS below is the fallback if the scan fails.
#           Today's picks are logged and saved to logs/watchlist_YYYY-MM-DD.csv. PROTECTED_SYMBOLS are never picked.
SYMBOL_MODE=fixed
SCAN_TOP=20
# ignore stocks below this price (rupees)
SCAN_MIN_PRICE=50
SYMBOLS=RELIANCE,INFY
EXCHANGE=NSE
# Stocks the bot must NEVER trade (e.g. your long-term holdings). Comma-separated.
PROTECTED_SYMBOLS=DELHIVERY,BAJAJFINSV
# minute, 3minute, 5minute, 10minute, 15minute, 30minute, 60minute, day
INTERVAL=15minute
FAST_PERIOD=9
SLOW_PERIOD=21
# SMA or EMA
MA_TYPE=EMA
# SHORT selling: false = LONG only (buy on golden cross, exit on death cross).
# true = also SHORT on a death cross and cover on a golden cross. Intraday only (PRODUCT=MIS);
# with MARKET_FILTER on, shorts open only when the market index is DOWN.
ALLOW_SHORT=false

# --- Market filter: follow the overall market ---
# Only open a long when the index is in an uptrend (index close above its EMA),
# and a short only when it's in a downtrend. Exits are never blocked.
MARKET_FILTER=true
MARKET_INDEX=NIFTY 50
# EMA length on the same candle INTERVAL as the strategy
MARKET_MA_PERIOD=50
# Neutral zone, in percent: while the index is within +/- this % of its EMA there's no clear trend,
# so NO new trades in either direction (exits still run). Avoids choppy, directionless sessions.
# Backtest (Jul-Oct 2026): +/-0.5% was the only setting tested that was profitable in both test periods,
# but NIFTY sits in that zone ~75% of the time, so expect fewer trades. 0 = off.
MARKET_NEUTRAL_PCT=0

# --- Orders ---
# MIS = intraday (auto square-off), CNC = delivery
PRODUCT=MIS

# --- Position sizing ---
# Risk-based: buy enough shares that hitting STOP_LOSS_PCT loses about this many rupees.
#   shares = RISK_PER_TRADE / (price x STOP_LOSS_PCT%)   e.g. 200 / (1000 x 1%) = 20 shares
# Set to 0 to trade a fixed QUANTITY of shares instead.
RISK_PER_TRADE=200
# Only used when RISK_PER_TRADE=0
QUANTITY=1
# PAPER_FUNDS: pretend Zerodha balance for paper mode (live mode uses your real Kite funds).
#   Works like a real account: each trade blocks Zerodha's actual margin (~20% intraday),
#   released when it closes; today's profit/loss and open losses adjust it.
#   Set it to the amount you plan to deposit, so paper results match that account.
PAPER_FUNDS=100000
# Limit price buffer from LTP, in percent (limit orders instead of market orders)
LIMIT_BUFFER_PCT=0.1
# Time (IST) to square off all MIS positions
SQUARE_OFF_TIME=15:15
# No new positions after this time (IST) - exits still happen. Leave empty to disable.
NO_NEW_ENTRIES_AFTER=14:30
# Join young trends: besides fresh crossovers, also enter a stock whose trend started within the last
# JOIN_MAX_AGE candles (7 x 60-min = about one trading day) and points the same way as the market.
# At most one join per stock per day; same exits and limits as other trades. Avoids old, tired trends.
# Backtest (60-min, 211 F&O stocks, Jul-Oct 2026): ~4.4 trades/day vs ~1.7, profitable in both test periods,
# but lower profit per trade (+0.11% vs +0.33%).
JOIN_YOUNG_TRENDS=false
JOIN_MAX_AGE=7

# --- Live-tick exits (WebSocket) ---
# Exit a position as soon as the live price moves this % against / in favour of the entry price.
# Set to 0 to disable. If both are 0, the WebSocket isn't started.
STOP_LOSS_PCT=1.0
TARGET_PCT=2.0

# --- Safety ---
# true = log signals and simulate fills only. Set to false ONLY when you're ready for real orders.
PAPER_TRADING=true
# Stop opening new positions after this many trades in a day
MAX_TRADES_PER_DAY=10

# --- Money limits (how much the bot may use) ---
# These cap the bot's spending no matter how much money is in your account.
# Each applies to NEW positions only - exits (stop-loss, target, crossovers, 15:15 close) always run.
# Set any of them to 0 to switch that limit off.
#
# MAX_CAPITAL_PER_TRADE: the most one position may be worth, in rupees (shares x price).
#   Stops one expensive stock from taking a huge position. Example: with 15000, DIXON at ~Rs 13,400
#   is limited to 1 share, and a Rs 1,000 stock to 15 shares, even if QUANTITY is higher.
MAX_CAPITAL_PER_TRADE=15000
#
# MAX_TOTAL_CAPITAL: the most ALL open positions together may be worth, in rupees.
#   Before opening a trade the bot adds up what is already invested; if the new trade would go
#   over this, it buys fewer shares or skips the trade. Works in paper and live mode, so the bot
#   never uses more than this even if your Kite account holds more (or Zerodha offers leverage).
MAX_TOTAL_CAPITAL=50000
#
# MAX_DAILY_LOSS: stop opening new trades for the rest of the day once today's loss reaches this,
#   in rupees. Counts closed trades' profit/loss plus the current loss on open positions.
#   Open positions are still managed and closed normally. Resets the next trading day.
MAX_DAILY_LOSS=1000

# --- Housekeeping ---
# At each start, delete log files (bot logs, news briefings, watchlists, scan/backtest outputs, backups) and rows in
# trades.csv / news_vetoes.csv older than this many days. 0 = keep everything. state/ is never touched.
KEEP_DAYS=0

# --- Morning news briefing (Claude) ---
# Once per day at startup: fetch market/stock news + a market snapshot and have Claude
# summarise it into logs/news_YYYY-MM-DD.md. Uses the Claude Code CLI logged in with your
# Claude subscription (no API key, no API billing).
#   off      = no briefing
#   advisory = briefing only, trades unchanged
#   veto     = briefing can BLOCK new trades for the day (never opens trades, never blocks exits):
#              results today -> no new trades in that stock;
#              bearish outlook -> no longs in it; bullish outlook -> no shorts in it.
#              Blocked trades are shadow-tracked in logs/news_vetoes.csv to measure if vetoes help.
NEWS_MODE=veto
# Optional: full path to the `claude` CLI if it isn't found automatically
CLAUDE_CLI_PATH=
# Optional: company names used for per-stock news searches, e.g. TMPV:Tata Motors,DIXON:Dixon Technologies
NEWS_NAMES=
